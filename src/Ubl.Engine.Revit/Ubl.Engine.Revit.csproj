<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Revit add-in. Build for a Revit version with:  dotnet build -c Release -p:RevitVersion=2026
    Revit 2025 and 2026 run on .NET 8; Revit 2027 runs on .NET 10.
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2026</RevitVersion>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)\</RevitInstallDir>
    <TargetFramework Condition="'$(RevitVersion)' &gt;= '2027'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' &lt; '2027'">net8.0-windows</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>false</UseWindowsForms>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AddinFolder>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)</AddinFolder>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ubl.Engine.Core\Ubl.Engine.Core.csproj" />
    <ProjectReference Include="..\Ubl.Engine.Dwg\Ubl.Engine.Dwg.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="engine.config.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="toilet.families.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="toilet.example.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="layers.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="project.example.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Ubl.Engine.Revit.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Deploy to the Revit add-ins folder after a Debug build so F5 / restart Revit picks it up. -->
  <Target Name="DeployAddin" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' And '$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <AddinFiles Include="$(TargetDir)**\*.*" Exclude="$(TargetDir)**\*.addin" />
    </ItemGroup>
    <Copy SourceFiles="@(AddinFiles)" DestinationFiles="@(AddinFiles->'$(AddinFolder)\Ubl.Engine.Revit\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)Ubl.Engine.Revit.addin" DestinationFolder="$(AddinFolder)" SkipUnchangedFiles="true" />
  </Target>

</Project>
